# AI provider (choose one; the desktop app can also store this in macOS Keychain)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Amazon Bedrock API-key auth (alternative AI provider)
AWS_BEDROCK_API_KEY=
AWS_BEDROCK_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# Eligible prompts use a five-minute Bedrock prefix cache. Unknown/custom
# models stay uncached unless their documented minimum is configured below.
AWS_BEDROCK_ENABLE_PROMPT_CACHE=true
# AWS_BEDROCK_CACHE_MIN_TOKENS=1024

# Maximum locally estimated tokens for memories, aggregates, and selected-thread
# evidence. The deterministic packer includes as much high-value detail as fits.
KNOWU_CONTEXT_TOKEN_BUDGET=3000
# Conservative locally estimated overall chat budget including conversation and
# a 1,600-token output reserve. Bedrock also enforces an exact CountTokens gate.
KNOWU_REQUEST_TOKEN_BUDGET=8000

# EverMind EverOS v1 persistent memory
EVEROS_API_KEY=
EVEROS_BASE_URL=https://api.evermind.ai
EVEROS_USER_ID=knowu-local-user

# Snowflake SQL API telemetry
SNOWFLAKE_ACCOUNT_URL=https://your-org-your-account.snowflakecomputing.com
# Snowflake PATs require an applicable network policy by default.
SNOWFLAKE_PROGRAMMATIC_ACCESS_TOKEN=
# Alternatively: SNOWFLAKE_OAUTH_TOKEN=
SNOWFLAKE_WAREHOUSE=KNOWU_WH
SNOWFLAKE_DATABASE=KNOWU
SNOWFLAKE_SCHEMA=ANALYTICS
SNOWFLAKE_ROLE=KNOWU_APP_ROLE

# Optional: send approved, derived prompt context to Snowflake AI_COUNT_TOKENS.
# Leave false for the strictest privacy posture; provider usage anchors the default estimate.
SNOWFLAKE_ENABLE_AI_COUNT_TOKENS=false
SNOWFLAKE_TOKEN_MODEL=llama3.3-70b

# Optional current provider prices used only for estimated cost display/telemetry.
# Set these explicitly because model pricing changes over time.
KNOWU_INPUT_COST_PER_MILLION=
KNOWU_OUTPUT_COST_PER_MILLION=
# Optional provider-specific cache rates. Reads fall back conservatively to the
# ordinary input rate; cache writes require an explicit rate for a cost estimate.
KNOWU_CACHE_READ_COST_PER_MILLION=
KNOWU_CACHE_WRITE_COST_PER_MILLION=
